<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EvilHop.Corpus</RootNamespace>
    <AssemblyName>EvilHop.Corpus</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- done to reflect EvilHop.Corpus's "frozen" status, unset after resolved -->
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>  
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EvilHop.Corpus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EvilHop/EvilHop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="BuildProfiles.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
